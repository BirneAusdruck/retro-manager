{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Projekt starten (python -m PAKET)",
      "type": "debugpy",
      "request": "launch",
      "module": "${config:uvProject.package}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Aktuelle Datei",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Tests debuggen (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
